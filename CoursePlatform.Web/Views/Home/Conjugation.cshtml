@model List<Adam.Models.ConjugationQuestion>
@{
    ViewData["Title"] = "Спряжение";
    var courseId = ViewBag.CourseId;
    var lessonId = ViewBag.LessonId;
}

<div class="conjugation-page">
    <div class="cards-header">
        <a asp-action="Lessons" asp-route-courseId="@courseId" class="back-btn"><i class="fas fa-arrow-left"></i></a>
        <div class="cards-progress">
            <span id="currentQ">1</span> / <span>@Model.Count</span>
        </div>
        <div class="progress-bar-custom">
            <div id="progressFill" class="progress-fill" style="width: @(Model.Count > 0 ? (1.0 / Model.Count * 100) : 0)%"></div>
        </div>
    </div>

    <div id="scoreBar" class="score-bar" style="display:none;">
        <span id="scoreCorrect" class="score-correct">0</span> правильно из <span id="scoreTotal">0</span>
    </div>

    <div class="questions-container" id="questionsContainer">
        @for (int i = 0; i < Model.Count; i++)
        {
            var q = Model[i];
            <div class="question-card @(i == 0 ? "active" : "")" data-index="@i" data-answer="@q.OssetianAnswer">
                <div class="question-label">Переведите на осетинский:</div>
                <div class="question-sentence">@q.RussianSentence</div>

                <div class="answer-section">
                    <input type="text" class="answer-input" id="answer_@i" placeholder="Введите перевод..." autocomplete="off" />
                    <div class="answer-feedback" id="feedback_@i"></div>
                </div>

                <button class="btn-hint" onclick="showHint(@i)">
                    <i class="fas fa-lightbulb"></i> Подсказка
                </button>
                <div class="hint-text" id="hint_@i" style="display:none;">
                    @q.Hint
                </div>
            </div>
        }
    </div>

    <div class="conjugation-result" id="resultSection" style="display:none;">
        <div class="result-icon"><i class="fas fa-trophy"></i></div>
        <h2>Тест завершён!</h2>
        <div class="result-score">
            <span id="finalScore">0</span> / @Model.Count
        </div>
        <p id="resultMessage"></p>
        <a asp-action="Lessons" asp-route-courseId="@courseId" class="btn-primary-custom">
            <i class="fas fa-arrow-left"></i> К уроку
        </a>
    </div>

    <div class="cards-actions" id="actionsBar">
        <a asp-action="Lessons" asp-route-courseId="@courseId" class="btn-exit">
            <i class="fas fa-sign-out-alt"></i> Выйти
        </a>
        <button id="btnCheck" class="btn-check" onclick="checkAnswer()">
            Проверить <i class="fas fa-check"></i>
        </button>
        <button id="btnNext" class="btn-next" style="display:none;" onclick="nextQuestion()">
            Продолжить <i class="fas fa-arrow-right"></i>
        </button>
    </div>
</div>

@section Scripts {
<script>
    let currentQ = 0;
    const totalQ = @Model.Count;
    let correctCount = 0;

    function normalize(str) {
        return str.trim().toLowerCase().replace(/ё/g, 'е').replace(/\s+/g, ' ');
    }

    function checkAnswer() {
        const card = document.querySelectorAll('.question-card')[currentQ];
        const input = document.getElementById('answer_' + currentQ);
        const feedback = document.getElementById('feedback_' + currentQ);
        const correctAnswer = card.dataset.answer;
        const userAnswer = input.value;

        input.disabled = true;

        if (normalize(userAnswer) === normalize(correctAnswer)) {
            feedback.innerHTML = '<i class="fas fa-check-circle"></i> Правильно!';
            feedback.className = 'answer-feedback correct';
            correctCount++;
        } else {
            feedback.innerHTML = '<i class="fas fa-times-circle"></i> Правильный ответ: <strong>' + correctAnswer + '</strong>';
            feedback.className = 'answer-feedback incorrect';
        }
        feedback.style.display = 'block';

        document.getElementById('btnCheck').style.display = 'none';
        document.getElementById('btnNext').style.display = 'flex';

        if (currentQ === totalQ - 1) {
            document.getElementById('btnNext').innerHTML = 'Завершить <i class="fas fa-flag-checkered"></i>';
        }
    }

    function nextQuestion() {
        if (currentQ >= totalQ - 1) {
            showResult();
            return;
        }

        const cards = document.querySelectorAll('.question-card');
        cards[currentQ].classList.remove('active');
        currentQ++;
        cards[currentQ].classList.add('active');

        document.getElementById('currentQ').textContent = currentQ + 1;
        document.getElementById('progressFill').style.width = ((currentQ + 1) / totalQ * 100) + '%';

        document.getElementById('btnCheck').style.display = 'flex';
        document.getElementById('btnNext').style.display = 'none';

        document.getElementById('answer_' + currentQ).focus();
    }

    function showHint(index) {
        const hint = document.getElementById('hint_' + index);
        hint.style.display = hint.style.display === 'none' ? 'block' : 'none';
    }

    function showResult() {
        document.getElementById('questionsContainer').style.display = 'none';
        document.getElementById('actionsBar').style.display = 'none';
        document.getElementById('resultSection').style.display = 'flex';
        document.getElementById('finalScore').textContent = correctCount;

        const pct = correctCount / totalQ * 100;
        const msg = document.getElementById('resultMessage');
        if (pct >= 80) msg.textContent = 'Отличный результат! Продолжайте в том же духе!';
        else if (pct >= 50) msg.textContent = 'Хороший результат. Попробуйте ещё раз для закрепления.';
        else msg.textContent = 'Не сдавайтесь! Повторите теорию и попробуйте снова.';
    }

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
            if (document.getElementById('btnCheck').style.display !== 'none') {
                checkAnswer();
            } else if (document.getElementById('btnNext').style.display !== 'none') {
                nextQuestion();
            }
        }
    });
</script>
}
