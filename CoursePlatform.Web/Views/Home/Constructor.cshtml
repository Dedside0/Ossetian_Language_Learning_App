@model Adam.Models.Lesson
@{
    ViewData["Title"] = "Конструктор урока";
    var courseId = (int)ViewBag.CourseId;
    var lessonId = (int)ViewBag.LessonId;
}

<div class="page-header">
    <a asp-action="Lessons" asp-route-courseId="@courseId" class="back-btn"><i class="fas fa-arrow-left"></i> К урокам</a>
    <h1>Конструктор урока</h1>
    <p class="subtitle">@Model.Title</p>
</div>

<div class="constructor-page">

    <div class="add-card-section" style="margin-bottom: 30px;">
        <h3>Редактировать текст Теории</h3>

        <form asp-action="UpdateTheory" method="post" id="theoryForm">
            <input type="hidden" name="courseId" value="@courseId" />
            <input type="hidden" name="lessonId" value="@lessonId" />

            <input type="hidden" name="theoryHtml" id="theoryHtmlInput" />

            <div class="quill-wrapper" style="border: 2px solid #ccc; border-radius: 10px; overflow: hidden;">

                <div id="my-custom-toolbar" class="my-cool-action-bar" style="background: #f3f3f3; padding: 8px; border-bottom: 1px solid #ccc;">
                    <button type = "button" class="ql-bold"><b>Ж</b></button>
                    <button type="button" class="ql-italic"><i>К</i></button>
                    <button type="button" class="ql-underline"><u>Ч</u></button>
                    <select type="button" class="ql-header">
                        <option selected>Обычный</option>
                        <option value="1">Заголовок 1</option>
                        <option value="2">Заголовок 2</option>
                    </select>
                </div>

                <div id="editor-container" style="min-height: 200px; font-size: 16px; background: #fff; color: #000;">
                    @Html.Raw(Model.TheoryHtml)
                </div>
            </div>

            <button type="submit" class="btn-primary-custom" style="margin-top: 10px;">
                <i class="fas fa-save"></i> Сохранить теорию
            </button>
        </form>
    </div>

    @if (Model.Cards.Any())
    {
        <div class="constructor-cards">
            <h3>Добавленные карточки (@Model.Cards.Count)</h3>
            <div class="mini-cards-grid">
                @foreach (var card in Model.Cards)
                {
                    <div class="mini-card">
                        <div class="mini-card-img">
                            @if (card.ImageUrl != null){
                                <img src="@card.ImageUrl" alt="@card.RussianWord" onerror="this.parentElement.innerHTML='<i class=\'fas fa-image\'></i>'" />
                            }
                        </div>
                        <div class="mini-card-text">
                            <strong>@card.OssetianWord</strong>
                            <span>@card.RussianWord</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <div class="add-card-section">
        <button type="button" class="btn-add-card" id="btnShowForm" onclick="toggleForm()">
            <i class="fas fa-plus"></i> Добавить карточку
        </button>

        <div id="cardForm" class="card-form" style="display:none;">
            <form asp-action="AddCard" method="post" enctype="multipart/form-data">
                <input type="hidden" name="courseId" value="@courseId" />
                <input type="hidden" name="lessonId" value="@lessonId" />
                <input type="hidden" name="audioUrl" id="audioUrl" value="" />
                <input type="hidden" name="imageUrl" id="imageUrl" value="" />

                <div class="form-group-custom">
                    <label><i class="fas fa-language"></i> Слово на осетинском</label>
                    <input type="text" name="ossetianWord" class="input-custom" placeholder="Например: Хæрын" required id="ossetianInput" />
                </div>

                <div class="form-group-custom">
                    <label><i class="fas fa-globe"></i> Слово на русском</label>
                    <input type="text" name="russianWord" class="input-custom" placeholder="Например: Есть" required id="russianInput" />
                </div>
                <div class="form-group-custom">
                    <label><i class="fas fa-image"></i> Изображение</label>
                    <div class="image-tabs">
                        <button type="button" class="tab-btn active" onclick="switchImageTab('upload')">
                            <i class="fas fa-upload"></i> Загрузить
                        </button>
                        <button type="button" class="tab-btn" onclick="switchImageTab('generate')">
                            <i class="fas fa-magic"></i> Сгенерировать
                        </button>
                    </div>
                </div>

                <div id="uploadTab" class="image-tab-content active">
                    <div class="form-group-custom">
                        <div class="file-input">
                            <input type="file" id="imageFile" accept="image/*" onchange="uploadImage()" style="width:100%">
                            <label for="imageFile">📁 Выберите файл</label>
                        </div>
                        <div class="file-hint">Поддерживаются форматы: JPG, PNG, GIF</div>
                    </div>
                </div>

                <div id="generateTab" class="image-tab-content" style="display:none;">
                    <div class="form-group-custom">
                        <textarea id="imagePrompt" class="input-custom" rows="2" placeholder="Опишите, какое изображение нужно сгенерировать... Например: 'Осетинский чайный стол с пирогами'"></textarea>
                        <button type="button" class="btn-generate-image" onclick="generateImage()">
                            <i class="fas fa-wand-magic"></i> Сгенерировать
                        </button>
                    </div>
                </div>
                <div class="form-group-custom" id="imagePreviewSection" style="display:none;">
                    <label>Превью изображения</label>
                    <div class="image-preview" id="imagePreview"></div>
                    <button type="button" class="btn-remove-image" onclick="removeImage()">
                        <i class="fas fa-trash"></i> Удалить
                    </button>
                </div>

                <div class="form-group-custom">
                    <label><i class="fas fa-microphone"></i> Запись аудио</label>
                    <div class="audio-recorder">
                        <button type="button" class="btn-record" id="btnRecord" onclick="toggleRecording()">
                            <i class="fas fa-microphone"></i> Записать произношение
                        </button>
                        <div id="recordingStatus" class="recording-status" style="display:none;">
                            <i class="fas fa-circle recording-dot"></i> Запись...
                        </div>
                        <audio id="audioPlayback" controls style="display:none; width:100%; margin-top:8px;"></audio>
                    </div>
                </div>

                <button type="submit" class="btn-primary-custom" id="btnSave">
                    <i class="fas fa-save"></i> Сохранить карточку
                </button>
                <button type="button" class="btn-cancel" onclick="toggleForm()">
                    Отмена
                </button>
            </form>
        </div>
    </div>
    <div class="constructor-cards font-app-base">
        

        @if (Model.ConjugationQuestions != null && Model.ConjugationQuestions.Count > 0)
        {
            <div class="table-header-flex">
                <h3>Вопросы в тесте (@(Model.ConjugationQuestions?.Count ?? 0))</h3>
            </div>
            <div class="table-responsive-custom">
                <table class="app-custom-table">
                    <thead>
                        <tr>
                            <th><i class="fas fa-globe"></i> Задание (Русский)</th>
                            <th><i class="fas fa-language"></i> Перевод (Осетинский)</th>
                            <th><i class="fas fa-lightbulb"></i> Подсказка для ученика</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var q in Model.ConjugationQuestions)
                        {
                            <tr>
                                <td class="table-cell-sentence">@q.RussianSentence</td>
                                <td class="table-cell-answer"><strong>@q.OssetianAnswer</strong></td>
                                <td class="table-cell-hint">
                                    @if (!string.IsNullOrEmpty(q.Hint))
                                    {
                                        <span class="hint-badge">@q.Hint</span>
                                    }
                                    else
                                    {
                                        <span class="hint-none">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    <div class="add-card-section" style="margin-bottom: 30px;">
        <button type="button" class="btn-add-card" id="btnShowQuestionForm" onclick="toggleQuestionForm()">
            <i class="fas fa-plus"></i> Добавить вопрос в тест
        </button>

        <div id="questionForm" class="card-form" style="display:none;">
            <form asp-action="AddConjugationQuestion" method="post">
                <input type="hidden" name="courseId" value="@courseId" />
                <input type="hidden" name="lessonId" value="@lessonId" />

                <div class="form-group-custom">
                    <label><i class="fas fa-globe"></i> Предложение на русском</label>
                    <input type="text" name="russianSentence" class="input-custom" placeholder="Например: Я пил воду" required />
                </div>

                <div class="form-group-custom">
                    <label><i class="fas fa-language"></i> Правильный перевод (на осетинском)</label>
                    <input type="text" name="ossetianAnswer" class="input-custom" placeholder="Например: Æз дон бануазтон" required />
                </div>

                <div class="form-group-custom">
                    <label><i class="fas fa-lightbulb"></i> Подсказка для ученика (необязательно)</label>
                    <input type="text" name="hint" class="input-custom" placeholder="Например: нуазын → бануазтон (1 л., ед.ч.)" />
                </div>

                <button type="submit" class="btn-primary-custom" id="btnSaveQuestion">
                    <i class="fas fa-save"></i> Сохранить
                </button>
                <button type="button" class="btn-cancel" onclick="toggleQuestionForm()">
                    Отмена
                </button>
            </form>
        </div>
    </div>

    
    <div class="constructor-footer">
        <a asp-action="Lessons" asp-route-courseId="@courseId" class="btn-primary-custom btn-done">
            <i class="fas fa-check"></i> Готово
        </a>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>

    <script>
        // Инициализация редактора Quill с привязкой к кастомному тулбару
        const quill = new Quill('#editor-container', {
            theme: 'snow',
            modules: {
                // Говорим Quill искать кнопки внутри id
                toolbar: '#my-custom-toolbar'
            }
        });

        // Забирает текст перед сохранением.
        document.getElementById('theoryForm').onsubmit = function() {
            const theoryHtmlInput = document.getElementById('theoryHtmlInput');
            theoryHtmlInput.value = quill.root.innerHTML;
        };

        let mediaRecorder;
        let audioChunks = [];
        let isRecording = false;

               function toggleForm() {
            const form = document.getElementById('cardForm');
            const btn = document.getElementById('btnShowForm');
            if (form.style.display === 'none') {
                form.style.display = 'block';
                btn.style.display = 'none';
                resetImageForm();
            } else {
                form.style.display = 'none';
                btn.style.display = 'flex';
            }
        }
    
    function toggleQuestionForm() {
        const form = document.getElementById('questionForm');
        const btn = document.getElementById('btnShowQuestionForm');

        if (form.style.display === 'none') {
            form.style.display = 'block';
            btn.style.display = 'none';
            setTimeout(() => {
                form.querySelector('input[name="russianSentence"]').focus();
            }, 50);
        } else {
            form.style.display = 'none';
            btn.style.display = 'block';
            form.querySelector('form').reset(); 
        }
    }
    

        async function toggleRecording() {
            const btn = document.getElementById('btnRecord');
            const status = document.getElementById('recordingStatus');
            const playback = document.getElementById('audioPlayback');
            const audioUrlField = document.getElementById('audioUrl');

            if (!isRecording) {
                try {
                    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                    mediaRecorder = new MediaRecorder(stream);
                    audioChunks = [];

                    mediaRecorder.ondataavailable = e => audioChunks.push(e.data);

                    mediaRecorder.onstop = async () => {
                        const blob = new Blob(audioChunks, { type: 'audio/webm' });
                        console.log('Создан blob:', blob.size, 'bytes');

                        const formData = new FormData();
                        formData.append('audioFile', blob, `recording_${Date.now()}.webm`);

                        try {
                            status.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Загрузка...';
                            const response = await fetch('/api/Audio/upload', {
                                method: 'POST',
                                body: formData
                            });

                            const result = await response.json();
                            console.log('Ответ сервера:', result);

                            if (result.success && audioUrlField) {
                                audioUrlField.value = result.fileUrl;
                                status.innerHTML = '<i class="fas fa-check-circle"></i> Сохранено!';
                                setTimeout(() => {
                                    if (status) status.style.display = 'none';
                                }, 1500);
                            } else {
                                status.innerHTML = '<i class="fas fa-exclamation-triangle"></i> Ошибка сервера';
                            }
                        } catch (err) {
                            console.error('Ошибка загрузки:', err);
                            status.innerHTML = '<i class="fas fa-exclamation-triangle"></i> Ошибка';
                        }

                        const tempUrl = URL.createObjectURL(blob);
                        playback.src = tempUrl;
                        playback.style.display = 'block';

                        stream.getTracks().forEach(t => t.stop());
                    };

                    mediaRecorder.start();
                    isRecording = true;
                    btn.innerHTML = '<i class="fas fa-stop"></i> Остановить';
                    btn.classList.add('recording');
                    status.style.display = 'flex';
                    status.innerHTML = '<i class="fas fa-circle recording-dot"></i> Запись...';
                } catch (err) {
                    console.error('Ошибка доступа к микрофону:', err);
                    alert('Не удалось получить доступ к микрофону. Проверьте разрешения.');
                }
            } else {
                if (mediaRecorder) {
                    mediaRecorder.stop();
                }
                isRecording = false;
                btn.innerHTML = '<i class="fas fa-microphone"></i> Записать снова';
                btn.classList.remove('recording');
                if (status) status.style.display = 'none';
            }
        }
        let currentImageTab = 'upload';
        function switchImageTab(tab) {
            currentImageTab = tab;
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('active');
            });
            event.target.classList.add('active');
            const uploadTab = document.getElementById('uploadTab');
            const generateTab = document.getElementById('generateTab');

            if (tab === 'upload') {
                uploadTab.style.display = 'block';
                generateTab.style.display = 'none';
            } else {
                uploadTab.style.display = 'none';
                generateTab.style.display = 'block';
            }
        }

        // Загрузка изображения через файл
        async function uploadImage() {
            const fileInput = document.getElementById('imageFile');
            const file = fileInput.files[0];
            if (!file) return;
            if (file.size > 5 * 1024 * 1024) {
                alert('Файл слишком большой. Максимальный размер 5MB.');
                return;
            }
            const allowedTypes = ['image/jpeg', 'image/png', 'image/gif', 'image/webp'];
            if (!allowedTypes.includes(file.type)) {
                alert('Поддерживаются только форматы: JPG, PNG, GIF, WEBP');
                return;
            }
            const formData = new FormData();
            formData.append('imageFile', file);
            showImageLoader();
            try {
                const response = await fetch('/api/Image/upload', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();

                if (result.success) {
                    document.getElementById('imageUrl').value = result.fileUrl;
                    showImagePreview(result.fileUrl);
                } else {
                    alert('Ошибка загрузки изображения: ' + (result.error || 'Неизвестная ошибка'));
                }
            } catch (error) {
                console.error('Ошибка:', error);
                alert('Не удалось загрузить изображение. Проверьте соединение.');
            }
        }

        // Генерация изображения через API
        async function generateImage() {
            const prompt = document.getElementById('imagePrompt').value.trim();

            if (!prompt) {
                alert('Пожалуйста, опишите, какое изображение нужно сгенерировать');
                return;
            }
            showImageLoader();
            try {
                const response = await fetch('/api/Image/generate', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        prompt: prompt,
                    })
                });

                const result = await response.json();

                if (result.success) {
                    document.getElementById('imageUrl').value = result.imageUrl;
                    showImagePreview(result.imageUrl);
                } else {
                    alert('Ошибка генерации изображения: ' + (result.error || 'Попробуйте другой запрос'));
                }
            } catch (error) {
                console.error('Ошибка:', error);
                alert('Не удалось сгенерировать изображение. Проверьте соединение.');
            }
        }

        // Показать превью изображения
        function showImagePreview(imageUrl) {
            const previewSection = document.getElementById('imagePreviewSection');
            const preview = document.getElementById('imagePreview');

            previewSection.style.display = 'block';
            preview.innerHTML = `<img src="${imageUrl}" alt="Preview" onerror="this.onerror=null; this.parentElement.innerHTML='<div style=\'padding:20px; color:#999;\'><i class=\'fas fa-image\'></i> Ошибка загрузки изображения</div>'" />`;
        }

        // Показать индикатор загрузки
        function showImageLoader() {
            const preview = document.getElementById('imagePreview');
            const previewSection = document.getElementById('imagePreviewSection');

            previewSection.style.display = 'block';
            preview.innerHTML = '<div style="padding:20px; text-align:center;"><div class="loading-spinner"></div><p>Загрузка...</p></div>';
        }

        // Удалить изображение
        function removeImage() {
            document.getElementById('imageUrl').value = '';
            document.getElementById('imagePreviewSection').style.display = 'none';
            document.getElementById('imagePreview').innerHTML = '';

            // Очищаем поля загрузки/генерации
            document.getElementById('imageFile').value = '';
            document.getElementById('imagePrompt').value = '';
        }
                function resetImageForm() {
            document.getElementById('imageUrl').value = '';
            document.getElementById('imagePreviewSection').style.display = 'none';
            document.getElementById('imagePreview').innerHTML = '';
            document.getElementById('imageFile').value = '';
            document.getElementById('imagePrompt').value = '';

            // Сбрасываем на вкладку загрузки
            currentImageTab = 'upload';
            const uploadTab = document.getElementById('uploadTab');
            const generateTab = document.getElementById('generateTab');
            uploadTab.style.display = 'block';
            generateTab.style.display = 'none';

            // Обновляем активную кнопку
            const btns = document.querySelectorAll('.tab-btn');
            btns.forEach(btn => btn.classList.remove('active'));
            btns[0].classList.add('active');
        }
    </script>
}