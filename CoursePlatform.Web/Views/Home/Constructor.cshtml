@model Adam.Models.Lesson
@{
    ViewData["Title"] = "Конструктор контента";
    var courseId = (int)ViewBag.CourseId;
    var lessonId = (int)ViewBag.LessonId;
}

<div class="page-header">
    <a asp-action="Lessons" asp-route-courseId="@courseId" class="back-btn"><i class="fas fa-arrow-left"></i> К урокам</a>
    <h1>Конструктор урока</h1>
    <p class="subtitle">@Model.Title</p>
</div>

<div class="constructor-page">

    <div class="constructor-tabs mb-4" style="display: flex; gap: 10px; border-bottom: 2px solid #eee; padding-bottom: 10px;">
        <button type="button" class="btn-tab active" onclick="switchTab('cardsTab', this)" style="padding: 10px 20px; border: none; background: #007bff; color: white; border-radius: 5px; cursor: pointer;">
            <i class="fas fa-clone"></i> Карточки слов
        </button>
        <button type="button" class="btn-tab" onclick="switchTab('listeningTab', this)" style="padding: 10px 20px; border: none; background: #6c757d; color: white; border-radius: 5px; cursor: pointer;">
            <i class="fas fa-headphones"></i> Аудирование
        </button>
    </div>

    <div id="cardsTabSection" class="tab-content">
        @if (Model.Cards.Any())
        {
            <div class="constructor-cards">
                <h3>Добавленные карточки (@Model.Cards.Count)</h3>
                <div class="mini-cards-grid">
                    @foreach (var card in Model.Cards)
                    {
                        <div class="mini-card">
                            <div class="mini-card-img">
                                <img src="@card.ImageUrl" alt="@card.RussianWord" onerror="this.parentElement.innerHTML='<i class=\'fas fa-image\'></i>'" />
                            </div>
                            <div class="mini-card-text">
                                <strong>@card.OssetianWord</strong>
                                <span>@card.RussianWord</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="add-card-section mt-3">
            <button type="button" class="btn-add-card" id="btnShowForm" onclick="toggleForm('cardForm', this)">
                <i class="fas fa-plus"></i> Добавить карточку
            </button>

            <div id="cardForm" class="card-form" style="display:none;">
                <form asp-action="AddCard" method="post">
                    <input type="hidden" name="courseId" value="@courseId" />
                    <input type="hidden" name="lessonId" value="@lessonId" />
                    <input type="hidden" name="audioUrl" id="audioUrlCard" value="" />

                    <div class="form-group-custom">
                        <label><i class="fas fa-language"></i> Слово на осетинском</label>
                        <input type="text" name="ossetianWord" class="input-custom" placeholder="Например: Хæрын" required />
                    </div>

                    <div class="form-group-custom">
                        <label><i class="fas fa-globe"></i> Слово на русском</label>
                        <input type="text" name="russianWord" class="input-custom" placeholder="Например: Есть" required id="russianInput" />
                    </div>

                    <div class="form-group-custom">
                        <label><i class="fas fa-microphone"></i> Запись аудио</label>
                        <div class="audio-recorder">
                            <button type="button" class="btn-record" onclick="toggleRecording('audioUrlCard', this, 'recordingStatusCard', 'audioPlaybackCard')">
                                <i class="fas fa-microphone"></i> Записать произношение
                            </button>
                            <div id="recordingStatusCard" class="recording-status" style="display:none;">
                                <i class="fas fa-circle recording-dot"></i> Запись...
                            </div>
                            <audio id="audioPlaybackCard" controls style="display:none; width:100%; margin-top:8px;"></audio>
                        </div>
                    </div>

                    <div class="form-group-custom" id="imagePreviewSection" style="display:none;">
                        <label>Превью изображения</label>
                        <div class="image-preview" id="imagePreview"></div>
                    </div>

                    <button type="submit" class="btn-primary-custom"><i class="fas fa-save"></i> Сохранить</button>
                    <button type="button" class="btn-cancel" onclick="toggleForm('cardForm', document.getElementById('btnShowForm'))">Отмена</button>
                </form>
            </div>
        </div>
    </div>

    <div id="listeningTabSection" class="tab-content" style="display: none;">
        @if (Model.ListeningTasks != null && Model.ListeningTasks.Any())
        {
            <div class="constructor-cards">
                <h3>Добавленные задания на слух (@Model.ListeningTasks.Count)</h3>
                <div class="mini-cards-grid">
                    @foreach (var task in Model.ListeningTasks)
                    {
                        // Исправляем и нормализуем путь к файлу перед выводом в плеер
                        var cleanTaskAudioUrl = task.AudioUrl.StartsWith("/") ? task.AudioUrl : "/" + task.AudioUrl;

                        <div class="mini-card" style="display: flex; align-items: center; padding: 10px; gap: 15px;">
                            <div class="audio-preview-btn" style="background: #e91e63; color: white; border-radius: 50%; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; cursor: pointer;" onclick="document.getElementById('task-audio-@task.Id').play()">
                                <i class="fas fa-play"></i>
                                <audio id="task-audio-@task.Id" src="@cleanTaskAudioUrl" preload="none"></audio>
                            </div>
                            <div class="mini-card-text">
                                <strong>@task.AudioDecoding</strong>
                                <span>@task.RussianTranslation</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="add-card-section mt-3">
            <button type="button" class="btn-add-card" id="btnShowListeningForm" onclick="toggleForm('listeningForm', this)">
                <i class="fas fa-plus"></i> Добавить задание на аудирование
            </button>

            <div id="listeningForm" class="card-form" style="display:none;">
                <form asp-action="AddListeningTask" method="post">
                    <input type="hidden" name="courseId" value="@courseId" />
                    <input type="hidden" name="lessonId" value="@lessonId" />
                    <input type="hidden" name="audioUrl" id="audioUrlListening" value="" />

                    <div class="form-group-custom">
                        <label><i class="fas fa-language"></i> Текст аудио (Правильный ответ на осетинском)</label>
                        <input type="text" name="audioDecoding" class="input-custom" placeholder="Например: Æз бахордтон" required />
                    </div>

                    <div class="form-group-custom">
                        <label><i class="fas fa-globe"></i> Перевод на русский (Подсказка)</label>
                        <input type="text" name="russianTranslation" class="input-custom" placeholder="Например: Я поел" />
                    </div>

                    <div class="form-group-custom">
                        <label><i class="fas fa-microphone"></i> Надиктуйте фразу</label>
                        <div class="audio-recorder">
                            <button type="button" class="btn-record" onclick="toggleRecording('audioUrlListening', this, 'recordingStatusListening', 'audioPlaybackListening')">
                                <i class="fas fa-microphone"></i> Записать фразу целиком
                            </button>
                            <div id="recordingStatusListening" class="recording-status" style="display:none;">
                                <i class="fas fa-circle recording-dot"></i> Запись...
                            </div>
                            <audio id="audioPlaybackListening" controls style="display:none; width:100%; margin-top:8px;"></audio>
                        </div>
                    </div>

                    <button type="submit" class="btn-primary-custom"><i class="fas fa-save"></i> Сохранить задание</button>
                    <button type="button" class="btn-cancel" onclick="toggleForm('listeningForm', document.getElementById('btnShowListeningForm'))">Отмена</button>
                </form>
            </div>
        </div>
    </div>

    <div class="constructor-footer mt-4">
        <a asp-action="Lessons" asp-route-courseId="@courseId" class="btn-primary-custom btn-done">
            <i class="fas fa-check"></i> Готово
        </a>
    </div>
</div>

@section Scripts {
<script>
    let mediaRecorder;
    let audioChunks = [];
    let isRecording = false;

    function switchTab(tabName, button) {
        document.querySelectorAll('.tab-content').forEach(el => el.style.display = 'none');
        document.querySelectorAll('.btn-tab').forEach(el => {
            el.style.background = '#6c757d';
            el.classList.remove('active');
        });

        if (tabName === 'cardsTab') {
            document.getElementById('cardsTabSection').style.display = 'block';
            button.style.background = '#007bff';
        } else {
            document.getElementById('listeningTabSection').style.display = 'block';
            button.style.background = '#e91e63';
        }
        button.classList.add('active');
    }

    function toggleForm(formId, btnElement) {
        const form = document.getElementById(formId);
        if (form.style.display === 'none') {
            form.style.display = 'block';
            btnElement.style.display = 'none';
        } else {
            form.style.display = 'none';
            if (formId === 'cardForm') document.getElementById('btnShowForm').style.display = 'flex';
            if (formId === 'listeningForm') document.getElementById('btnShowListeningForm').style.display = 'flex';
        }
    }

    document.getElementById('russianInput').addEventListener('input', function() {
        const val = this.value.trim();
        const section = document.getElementById('imagePreviewSection');
        const preview = document.getElementById('imagePreview');
        if (val.length > 0) {
            section.style.display = 'block';
            preview.innerHTML = '<img src="https://via.placeholder.com/300x200?text=' + encodeURIComponent(val) + '" alt="' + val + '" />';
        } else {
            section.style.display = 'none';
        }
    });

    async function toggleRecording(hiddenFieldId, btnElement, statusId, playbackId) {
        const audioUrlField = document.getElementById(hiddenFieldId);
        const status = document.getElementById(statusId);
        const playback = document.getElementById(playbackId);

        if (!isRecording) {
            try {
                const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                mediaRecorder = new MediaRecorder(stream);
                audioChunks = [];

                mediaRecorder.ondataavailable = e => audioChunks.push(e.data);

                mediaRecorder.onstop = async () => {
                    const blob = new Blob(audioChunks, { type: 'audio/webm' });
                    const formData = new FormData();
                    formData.append('audioFile', blob, `recording_${Date.now()}.webm`);

                    try {
                        status.style.display = 'flex';
                        status.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Загрузка...';

                        const response = await fetch('/api/Audio/upload', {
                            method: 'POST',
                            body: formData
                        });

                        const result = await response.json();

                        if (result.success && audioUrlField) {
                            audioUrlField.value = result.fileUrl;
                            status.innerHTML = '<i class="fas fa-check-circle"></i> Сохранено!';
                            setTimeout(() => {
                                status.style.display = 'none';
                            }, 1500);
                        } else {
                            status.innerHTML = '<i class="fas fa-exclamation-triangle"></i> Ошибка сервера';
                        }
                    } catch (err) {
                        status.innerHTML = '<i class="fas fa-exclamation-triangle"></i> Ошибка';
                    }

                    const tempUrl = URL.createObjectURL(blob);
                    playback.src = tempUrl;
                    playback.style.display = 'block';

                    stream.getTracks().forEach(t => t.stop());
                };

                mediaRecorder.start();
                isRecording = true;
                btnElement.innerHTML = '<i class="fas fa-stop"></i> Остановить';
                btnElement.classList.add('recording');
                status.style.display = 'flex';
                status.innerHTML = '<i class="fas fa-circle recording-dot"></i> Запись...';
            } catch (err) {
                alert('Не удалось получить доступ к микрофону. Проверьте разрешения.');
            }
        } else {
            if (mediaRecorder) {
                mediaRecorder.stop();
            }
            isRecording = false;
            btnElement.innerHTML = '<i class="fas fa-microphone"></i> Забавить снова';
            btnElement.classList.remove('recording');
            status.style.display = 'none';
        }
    }
</script>
}